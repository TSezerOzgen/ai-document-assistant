# Claude API anahtari  ->  https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ngrok token (SADECE WhatsApp icin gerekli)
# Ucretsiz hesap ac, token'i buraya yapistir:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=
